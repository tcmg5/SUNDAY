# Copy to .env. This file is gitignored; keys never belong in config.yaml.

# Required — the reasoning core.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — only if tts.engine is "elevenlabs".
ELEVENLABS_API_KEY=

# Optional — better web search than the DuckDuckGo default.
BRAVE_API_KEY=
TAVILY_API_KEY=

# Optional — only if stt.engine is "whisper-api".
OPENAI_API_KEY=
